<mxCell id="t1" value="Weave — end-to-end flow (Workflow A + B/C + follow-up). Numbers = order in the demo. Colors = owning workstream: 01 grey, 02 purple, 03 blue, 04 orange, 05 green, 06 yellow. Dashed = read of consented data through the coordination boundary." style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="10" y="8" width="1980" height="40" as="geometry"/></mxCell>
<mxCell id="lane2" value="Consumer app&lt;br&gt;(web, 02 · 03 · 06)" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=36;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;fontStyle=1;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="0" y="60" width="2000" height="180" as="geometry"/></mxCell>
<mxCell id="lane3" value="Personal AI agent &amp;&lt;br&gt;coordination (02 · 03)" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=36;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;fontStyle=1;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="0" y="240" width="2000" height="180" as="geometry"/></mxCell>
<mxCell id="lane4" value="Demand &amp; proposal&lt;br&gt;engine (04)" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=36;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;fontStyle=1;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="0" y="420" width="2000" height="180" as="geometry"/></mxCell>
<mxCell id="lane5" value="Platform data&lt;br&gt;(Supabase + RLS, 01)" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=36;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;fontStyle=1;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="0" y="600" width="2000" height="180" as="geometry"/></mxCell>
<mxCell id="lane6" value="Business app (05)" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=36;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;fontStyle=1;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="0" y="780" width="2000" height="180" as="geometry"/></mxCell>
<mxCell id="n7" value="1. Sign up, adult check,&lt;br&gt;onboarding chat with agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="110" width="190" height="78" as="geometry"/></mxCell>
<mxCell id="n8" value="2. Review inferred prefs,&lt;br&gt;set discoverability + consent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="110" width="190" height="78" as="geometry"/></mxCell>
<mxCell id="n9" value="3. Match page: compatible&lt;br&gt;people + why · connect ·&lt;br&gt;create group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="530" y="110" width="190" height="78" as="geometry"/></mxCell>
<mxCell id="n10" value="8. Feed shows published event&lt;br&gt;with personal explanation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1220" y="110" width="190" height="78" as="geometry"/></mxCell>
<mxCell id="n11" value="9. RSVP (capacity-safe) ·&lt;br&gt;see consenting attendees ·&lt;br&gt;invite group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1450" y="110" width="190" height="78" as="geometry"/></mxCell>
<mxCell id="n12" value="10. Event completed → feedback&lt;br&gt;→ mutual reconnect → agent&lt;br&gt;suggests follow-up meetup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1680" y="110" width="190" height="78" as="geometry"/></mxCell>
<mxCell id="n13" value="LLM: extract structured&lt;br&gt;preferences (Zod schema,&lt;br&gt;no invention)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="290" width="190" height="78" as="geometry"/></mxCell>
<mxCell id="n14" value="Coordination boundary&lt;br&gt;getSharablePreferences(user,&lt;br&gt;purpose) → consented fields only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="290" width="190" height="78" as="geometry"/></mxCell>
<mxCell id="n15" value="Compatibility engine:&lt;br&gt;hard filters + weighted score&lt;br&gt;35/25/20/10/10 + explanation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="530" y="290" width="190" height="78" as="geometry"/></mxCell>
<mxCell id="n16" value="Explain recommendation&lt;br&gt;(fast model, grounded,&lt;br&gt;post-checked)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1220" y="290" width="190" height="78" as="geometry"/></mxCell>
<mxCell id="n17" value="Follow-up suggestion&lt;br&gt;(only on mutual consent)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1680" y="290" width="190" height="78" as="geometry"/></mxCell>
<mxCell id="n18" value="4. Collect consented signals →&lt;br&gt;bucket by category × slot ×&lt;br&gt;geocell → merge by radius" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="530" y="470" width="190" height="78" as="geometry"/></mxCell>
<mxCell id="n19" value="Privacy threshold:&lt;br&gt;cohort ≥ MIN_COHORT_SIZE (4),&lt;br&gt;raw counts → bands" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="760" y="470" width="190" height="78" as="geometry"/></mxCell>
<mxCell id="n20" value="5. Match venue (category,&lt;br&gt;capacity, hours, price, distance)&lt;br&gt;→ LLM proposal → validate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="990" y="470" width="190" height="78" as="geometry"/></mxCell>
<mxCell id="n21" value="profiles · user_preferences ·&lt;br&gt;agent_profiles (consent) ·&lt;br&gt;agent_messages (private)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="650" width="190" height="78" as="geometry"/></mxCell>
