# Copy to .env.local for Next.js and to .env for the seed runner / tests.
# Values below are the defaults printed by `pnpm db:start` for the local Supabase stack.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key-from-pnpm-db-start
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key-from-pnpm-db-start

# Anthropic. Leave empty and set MOCK_AI=1 to run fully offline.
ANTHROPIC_API_KEY=
MOCK_AI=1

# Demo / ops
DEMO_MODE=1
MIN_COHORT_SIZE=4
OPPORTUNITY_CRON_SECRET=change-me-for-cron-calls

# Public origin used in auth emails (magic link, confirmation). Defaults to http://127.0.0.1:3000.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3100

# 1 = expose the dev-only routes under /api/dev (fixture proposals, test sign-in).
# Local and preview only; they also refuse whenever VERCEL_ENV is "production".
ENABLE_DEV_ROUTES=1

# Wall-clock timezone a venue's hours and proposal slots are resolved in (workstream 05).
VENUE_TIMEZONE=America/Los_Angeles

# Demo event texts (workstream 06). Off unless both SMS_DEMO_* are set: then only that user's
# RSVP, reconfirm, cancellation and follow-up notifications are texted to that one number.
# Without the TWILIO_* keys the text is logged ("sms.console") instead of sent. A Twilio trial
# can only text numbers verified in its console. Never commit real values.
SMS_DEMO_TO=
SMS_DEMO_USER_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
