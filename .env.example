# Supabase (local stack defaults from `supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic
ANTHROPIC_API_KEY=
# 1 = return fixture JSON instead of calling Claude
MOCK_AI=1

# 1 = expose the dev-only routes under /api/dev (fixture proposals, test sign-in).
# Local and preview only. Never set this on a production deployment; the routes also
# refuse when VERCEL_ENV is "production".
ENABLE_DEV_ROUTES=1
