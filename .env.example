# Copy to .env.local for Next.js and to .env for the seed runner / tests.
# Values below are the defaults printed by `pnpm db:start` for the local Supabase stack.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key-from-pnpm-db-start
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key-from-pnpm-db-start

# Which vendor src/lib/ai talks to: muse | llama | anthropic. Leave unset to auto-detect from the
# keys below (Muse first, then Llama, then Anthropic). MOCK_AI=1 overrides this entirely.
AI_PROVIDER=

# Meta Model API (https://dev.meta.ai) -- serves the Muse Spark reasoning models. Key format is
# "LLM|<app-id>|<token>"; the pipes are part of it, so keep the value quoted.
# NOTE: a Muse entitlement is separate from a Llama API entitlement; one does not imply the other.
META_API_KEY=
# Optional: override the origin (default https://api.meta.ai/v1) and the model per tier.
META_API_BASE_URL=
MUSE_MODEL_SMART=
MUSE_MODEL_FAST=

# Muse Spark is a reasoning model and spends hidden reasoning tokens before replying, so it gets
# a larger default budget. Set this to override the budget for every provider.
AI_MAX_TOKENS=

# Meta Llama API (https://llama.developer.meta.com). The key is "LLM|<app-id>|<token>" -- the
# pipes are part of the key, so keep the value quoted or the shell will split it.
# The app must also have the models granted to it, or every call returns 403 permission_denied.
LLAMA_API_KEY=
# Optional: point at a gateway/proxy instead of https://api.llama.com/compat/v1
LLAMA_API_BASE_URL=
# Optional: override the model per tier if your app is provisioned for different ones.
LLAMA_MODEL_SMART=
LLAMA_MODEL_FAST=

# Anthropic. Leave empty and set MOCK_AI=1 to run fully offline.
ANTHROPIC_API_KEY=
MOCK_AI=1

# Demo / ops
DEMO_MODE=1
MIN_COHORT_SIZE=4
OPPORTUNITY_CRON_SECRET=change-me-for-cron-calls

# Public origin used in auth emails (magic link, confirmation). Defaults to http://127.0.0.1:3000.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3100

# 1 = expose the dev-only routes under /api/dev (fixture proposals, test sign-in).
# Local and preview only; they also refuse whenever VERCEL_ENV is "production".
ENABLE_DEV_ROUTES=1

# Wall-clock timezone a venue's hours and proposal slots are resolved in (workstream 05).
VENUE_TIMEZONE=America/Los_Angeles
