# Copy to .env.local for Next.js and to .env for the seed runner / tests.
# Values below are the defaults printed by `pnpm db:start` for the local Supabase stack.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key-from-pnpm-db-start
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key-from-pnpm-db-start

# Anthropic. Leave empty and set MOCK_AI=1 to run fully offline.
ANTHROPIC_API_KEY=
MOCK_AI=1

# Demo / ops
DEMO_MODE=1
MIN_COHORT_SIZE=4
OPPORTUNITY_CRON_SECRET=change-me-for-cron-calls

# Public origin used in auth emails (magic link, confirmation). Defaults to http://127.0.0.1:3000.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3100
